<?xml version="1.0" encoding="utf-8" ?>
<!--
    Dichiarazione XML:
    - version="1.0" indica la versione dello standard XML
    - encoding="utf-8" specifica la codifica dei caratteri
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <!--
        Tag principale del file POM.
        Rappresenta il progetto Maven.
        xmlns definisce il namespace XML usato da Maven.
    -->
    <modelVersion>4.0.0</modelVersion>
    <!--
        Versione del modello POM.
        Attualmente Maven utilizza la 4.0.0.
        NON è la versione del progetto, ma del formato del POM.
    -->
    <groupId>com.nomedellacompagnia</groupId>
    <!--
        Identifica il gruppo (azienda, organizzazione o dominio).
        Segue di solito la convenzione del dominio inverso.
        Serve per identificare in modo univoco il progetto.
    -->
    <artifactId>ProgettoSemplice</artifactId>
    <!--
        Nome del progetto/artefatto generato.
        Sarà il nome del file JAR (es: ProgettoSemplice-1.0-SNAPSHOT.jar).
    -->
    <version>1.0-SNAPSHOT</version>
    <!--
        Versione del progetto.
        - SNAPSHOT indica una versione in sviluppo.
        - Una versione stabile sarebbe ad esempio 1.0.0.
    -->
    <packaging>jar</packaging>
    <!--
        Tipo di pacchetto generato.
        jar = Java ARchive (libreria o applicazione Java).
        Altri esempi: war (web application), ear, pom.
    -->
    <dependencies>
        <!--
            Sezione che contiene tutte le dipendenze esterne
            necessarie al progetto.
            Maven le scarica automaticamente dai repository.
        -->
        <dependency>
            <!--
                Definizione di una singola dipendenza.
            -->
            <groupId>org.apache.commons</groupId>
            <!--
                Gruppo a cui appartiene la libreria.
            -->
            <artifactId>commons-lang3</artifactId>
            <!--
                Nome della libreria.
                In questo caso è Apache Commons Lang.
            -->
            <version>3.12.0</version>
            <!--
                Versione specifica della libreria da utilizzare.
                È importante fissarla per garantire stabilità.
            -->
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.9.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
            <!--
                Versione SNAPSHOT: build in sviluppo,
                soggetta a modifiche e aggiornamenti frequenti.
            -->
            <version>6.1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
    <!--
        Repository aggiuntivo necessario perché le versioni SNAPSHOT
        di Spring non sono pubblicate su Maven Central.
    -->
    <repositories>
        <repository>
            <id>spring-snapshot</id>
            <!--
                Repository ufficiale Spring per artefatti in sviluppo.
            -->
            <url>https://repo.spring.io/snapshot</url>
            <!--
                Configurazione delle versioni SNAPSHOT.
                Se enabled è true, il repository può fornire
                versioni in sviluppo (es. 6.1.0-SNAPSHOT).
            -->
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <!--
                Configurazione delle versioni RELEASE (stabili).
                Se enabled è false, il repository NON verrà usato
                per versioni definitive (es. 6.1.0).
            -->
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>
    <!--
    Sezione dedicata alla fase di build del progetto.
    Qui si configurano plugin e comportamento della compilazione.
-->
    <build>
        <!--
            Contiene l'elenco dei plugin Maven utilizzati durante la build.
        -->
        <plugins>
            <!--
                Definizione di un singolo plugin.
            -->
            <plugin>
                <!--
                    Gruppo che fornisce il plugin.
                    In questo caso i plugin ufficiali di Apache Maven.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <!--
                    Plugin responsabile della compilazione del codice Java.
                    Permette di configurare versione del compilatore e opzioni.
                -->
                <artifactId>maven-compiler-plugin</artifactId>
                <!--
                    Versione del plugin utilizzata per la compilazione.
                -->
                <version>3.11.0</version>
                <!--
                    Sezione di configurazione specifica del plugin.
                -->
                <configuration>
                    <!--
                        Indica la versione del linguaggio Java target.
                        Con release 17 il codice viene compilato
                        per essere compatibile con Java 17.
                    -->
                    <release>17</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>